[Unit]
Description=ICSD Forms (gunicorn) — /srv/icsdforms
After=network.target postgresql.service

[Service]
User=icsdforms
Group=www-data
WorkingDirectory=/srv/icsdforms/app
RuntimeDirectory=icsdforms
RuntimeDirectoryMode=0755
# سوکت و فایل‌های آپلودی برای nginx (گروه www-data) قابل دسترس باشند
UMask=0007
ExecStart=/srv/icsdforms/venv/bin/gunicorn config.wsgi:application --bind unix:/run/icsdforms/gunicorn.sock --workers 2 --threads 2 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
# محدودیت منابع تا روی سایت‌های دیگر اثر نگذارد
MemoryMax=900M
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
